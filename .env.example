# ==============================================================================
# CLAIMBRIDGE ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env for local testing. NEVER commit real credentials to git!
# ==============================================================================

# Application Environment
# Allowed values: 'development', 'test', 'sandbox'. 'production' requires strict TLS & secret validation.
CLAIMBRIDGE_ENV=development
PORT=8080
LOG_LEVEL=info

# Public URLs & Origins
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:3000

# Database Connection (PostgreSQL 16)
DATABASE_URL=postgres://claimbridge:claimbridge_local_dev_only@localhost:5432/claimbridge_dev?sslmode=disable

# Authentication & Session Security
SESSION_COOKIE_NAME=claimbridge_session
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=72
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30
REQUIRE_EMAIL_VERIFICATION=true

# Local Email Delivery (Mailpit SMTP)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@claimbridge.local
SMTP_USER=""
SMTP_PASS=""

# PayPal Sandbox Integration
# SAFETY RULE: PAYPAL_ENV MUST strictly be 'sandbox' in this milestone.
# Production PayPal API calls are blocked at configuration validation time.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_SANDBOX_BASE_URL=https://api-m.sandbox.paypal.com

# Request & Payout Safety Settings
PAYPAL_REQUEST_TIMEOUT_SECONDS=15
PAYPAL_MAX_RETRY_COUNT=0

# Policy Engine Configuration
POLICY_MAX_SINGLE_PAYOUT_CENTS=50000
POLICY_REQUIRE_DUAL_APPROVAL_ABOVE_CENTS=25000
