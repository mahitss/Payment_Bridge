# ==============================================================================
# CLAIMBRIDGE ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env for local testing. NEVER commit real credentials to git!
# ==============================================================================

# Application Environment
# Allowed values: 'development', 'test', 'sandbox'. 'production' requires strict TLS & secret validation.
CLAIMBRIDGE_ENV=development
PORT=8080
LOG_LEVEL=info

# Public URLs & Origins
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:3000

# Database Connection (PostgreSQL 16)
DATABASE_URL=postgres://claimbridge:claimbridge_local_dev_only@localhost:5432/claimbridge_dev?sslmode=disable

# Authentication & Session Security
SESSION_COOKIE_NAME=claimbridge_session
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=72
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30
REQUIRE_EMAIL_VERIFICATION=true

# Local Email Delivery (Mailpit SMTP)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@claimbridge.local
SMTP_USER=""
SMTP_PASS=""

# PayPal Sandbox Integration
# SAFETY RULE: PAYPAL_ENV MUST strictly be 'sandbox' in this milestone.
# Production PayPal API calls are blocked at configuration validation time.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_SANDBOX_BASE_URL=https://api-m.sandbox.paypal.com

# PayPal Webhook Verification & Staging Settings
# - For PayPal Webhook Simulator: Set to 'WEBHOOK_ID' (strictly blocked if CLAIMBRIDGE_ENV=production)
# - For Live Sandbox Webhook: Set to the registered Webhook ID from PayPal Developer Dashboard
PAYPAL_WEBHOOK_ID=WEBHOOK_ID

# Webhook Background Recovery Worker Settings
WEBHOOK_RECOVERY_INTERVAL_SECONDS=30
WEBHOOK_RECOVERY_OLDER_THAN_SECONDS=60
WEBHOOK_RECOVERY_BATCH_SIZE=50

# Database Auto-Migration
# Set to 'true' in staging/container environments to automatically apply embedded migrations on boot
DATABASE_AUTOMIGRATE=true

# Request & Payout Safety Settings
PAYPAL_REQUEST_TIMEOUT_SECONDS=15
PAYPAL_MAX_RETRY_COUNT=0

# Policy Engine Configuration
POLICY_MAX_SINGLE_PAYOUT_CENTS=50000
POLICY_REQUIRE_DUAL_APPROVAL_ABOVE_CENTS=25000

# Frontend Evaluation Mode
# Set to 'true' to display the local evaluator demo credentials banner on the landing page.
# Default is 'false' (evaluator banner hidden, normal registration and login active).
NEXT_PUBLIC_DEMO_MODE=false

# ==============================================================================
# AI Investigation Engine (Local Free-Tier Inference via Ollama)
# ==============================================================================
# - Set AI_ENABLED=false to run in offline evaluation mode (payout & policy flows remain 100% operational).
# - When AI_ENABLED=true, ClaimBridge routes inference to local Ollama via native bounded /api/chat transport.
# - Supported local models: 'qwen3.5:4b' (recommended & benchmarked ~60.6s on CPU) or 'llama3.2'.
AI_ENABLED=false
AI_PROVIDER=ollama
AI_BASE_URL=http://localhost:11434
AI_MODEL=qwen3.5:4b
AI_CONTEXT_SIZE=4096
AI_MAX_OUTPUT_TOKENS=512
AI_REQUEST_TIMEOUT_SECONDS=180
AI_API_KEY=""
